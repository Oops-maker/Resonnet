# Place .env at project root or backend/; backend loads project root first when submodule
# Claude Agent SDK (round discussion orchestration)
# Used for discussion, expert_reply; integration tests require real key
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# AI generation API (expert/moderator generation)
# Used by generation.py; do not mix with ANTHROPIC_*
AI_GENERATION_BASE_URL=
AI_GENERATION_API_KEY=
AI_GENERATION_MODEL=

# Workspace directory (optional, default ./workspace)
WORKSPACE_BASE=./workspace

# Scenario / skills preset (optional, default topic-lab). Choose ONE:
# - SCENARIO_PRESET: topic-lab | default | <custom_scenario_name>
# - SKILLS_BASE: custom path (overrides SCENARIO_PRESET when both set)
# SCENARIO_PRESET=topic-lab
# SKILLS_BASE=./skills/scenarios/topic-lab

# Docker Compose: host mount path for workspace (optional, default ./workspace)
WORKSPACE_HOST_DIR=./workspace
