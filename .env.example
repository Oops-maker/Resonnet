# Resonnet - Standalone Environment
# Copy to .env (project root or backend/). When used as TopicLab submodule, env is in project root.
# cp .env.example .env

# -----------------------------------------------------------------------------
# Claude Agent SDK (round discussion, expert reply)
# Integration tests require a real key; "test" placeholder fails acceptance.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# -----------------------------------------------------------------------------
# AI generation API (expert/moderator generation via HTTP)
# Do NOT mix with ANTHROPIC_*; these are separate systems.
# -----------------------------------------------------------------------------
AI_GENERATION_BASE_URL=
AI_GENERATION_API_KEY=
AI_GENERATION_MODEL=
# Account/auth service used for bearer token validation
# In Docker Compose: http://topiclab-backend:8000
# In local dev:      http://127.0.0.1:8001
AUTH_SERVICE_BASE_URL=http://topiclab-backend:8000

# Profile sync: persist completed profiles to topiclab-backend digital_twins table.
# When true, save_profile() syncs role_content to digital_twins after every write.
# On session rebuild, profile is pulled back from digital_twins if local file is missing.
# Requires: AUTH_SERVICE_BASE_URL pointing to topiclab-backend AND user auth token.
# false = local filesystem only (default for standalone / local dev)
# true  = sync enabled (required for multi-instance or cross-restart profile persistence)
ACCOUNT_SYNC_ENABLED=false

# -----------------------------------------------------------------------------
# Workspace & libs
# -----------------------------------------------------------------------------
# Workspace directory for topics, posts, discussion artifacts (default: ./workspace)
WORKSPACE_BASE=./workspace

# Docker Compose host mount path (default: ./workspace)
WORKSPACE_HOST_DIR=./workspace

# Libs meta cache TTL in seconds. 0 = no cache (hot-reload). Default: 60
# LIBS_CACHE_TTL_SECONDS=60

# Prefer Anthropic sandbox-runtime when available.
# true: use srt (if installed); false: fallback to legacy sandbox backend.
SANDBOX_USE_SRT=true

# Semantic search default switch.
ENABLE_SEMANTIC_SEARCH=true

# -----------------------------------------------------------------------------
# Web Search (BoCha API)
# Used by libs/assignable_skills/default/tools/web_search.md
# -----------------------------------------------------------------------------
BOCHA_API_KEY=
