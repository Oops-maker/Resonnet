# Resonnet - Standalone Environment
# Copy to .env (project root or backend/). When used as TopicLab submodule, env is in project root.
# cp .env.example .env

# -----------------------------------------------------------------------------
# Claude Agent SDK (round discussion, expert reply)
# Integration tests require a real key; "test" placeholder fails acceptance.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# -----------------------------------------------------------------------------
# AI generation API (expert/moderator generation via HTTP)
# Do NOT mix with ANTHROPIC_*; these are separate systems.
# -----------------------------------------------------------------------------
AI_GENERATION_BASE_URL=
AI_GENERATION_API_KEY=
AI_GENERATION_MODEL=
# Account/auth service used for bearer token validation
AUTH_SERVICE_BASE_URL=http://topiclab-backend:8000

# -----------------------------------------------------------------------------
# Workspace & libs
# -----------------------------------------------------------------------------
# Workspace directory for topics, posts, discussion artifacts (default: ./workspace)
WORKSPACE_BASE=./workspace

# Docker Compose host mount path (default: ./workspace)
WORKSPACE_HOST_DIR=./workspace

# Libs meta cache TTL in seconds. 0 = no cache (hot-reload). Default: 60
# LIBS_CACHE_TTL_SECONDS=60

