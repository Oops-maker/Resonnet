{
  "categories": {
    "development": {"id": "development", "name": "开发工具", "description": "开发、调试和检查工具"},
    "knowledge": {"id": "knowledge", "name": "知识管理", "description": "记忆、上下文和知识库管理"},
    "web_content": {"id": "web_content", "name": "网络内容", "description": "网页抓取、内容提取和文章处理"},
    "utilities": {"id": "utilities", "name": "实用工具", "description": "时间查询、技能管理等辅助工具"}
  },
  "mcps": {
    "inspector": {
      "id": "inspector",
      "source": "default",
      "name": "MCP Inspector",
      "description": "调试和检查 MCP 服务器",
      "category": "development",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/inspector"]
    },
    "memory": {
      "id": "memory",
      "source": "default",
      "name": "MCP Memory",
      "description": "持久化知识图谱，存储实体、关系和观察",
      "category": "knowledge",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "fetch": {
      "id": "fetch",
      "source": "default",
      "name": "MCP Fetch",
      "description": "获取网页内容并转换为 Markdown",
      "category": "web_content",
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "time": {
      "id": "time",
      "source": "default",
      "name": "MCP Time",
      "description": "获取当前时间和时区信息",
      "category": "utilities",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-time"]
    },
    "crawl-mcp": {
      "id": "crawl-mcp",
      "source": "default",
      "name": "Crawl MCP",
      "description": "基于 LLM 的网页爬取和内容分析",
      "category": "web_content",
      "command": "uvx",
      "args": ["crawl-mcp"],
      "env": {
        "OPENAI_API_KEY": "${MCP_API_KEY}",
        "OPENAI_BASE_URL": "${MCP_BASE_URL}",
        "LLM_MODEL": "${MCP_MODEL}"
      }
    },
    "article-mcp": {
      "id": "article-mcp",
      "source": "default",
      "name": "Article MCP",
      "description": "从网页中提取和处理文章",
      "category": "web_content",
      "command": "uvx",
      "args": ["article-mcp==0.1.8", "server"],
      "env": {}
    },
    "Wan26Media": {
      "id": "Wan26Media",
      "source": "default",
      "name": "Image Generation",
      "description": "阿里云百炼_万相2.6-图像视频生成",
      "category": "web_content",
      "type": "http",
      "url": "https://dashscope.aliyuncs.com/api/v1/mcps/Wan26Media/mcp",
      "headers": {
        "Authorization": "Bearer ${DASHSCOPE_API_KEY}"
      },
      "isActive": true
    },
    "market-cmapi00069848": {
      "id": "market-cmapi00069848",
      "source": "default",
      "name": "Web Search",
      "description": "博查是一款专为AI应用打造的世界知识搜索引擎，通过多模态混合搜索与语义排序技术，为AI Agents、Chatbots及RAG场景提供干净、准确、高质量的实时搜索结果。",
      "category": "web_content",
      "type": "http",
      "url": "https://dashscope.aliyuncs.com/api/v1/mcps/market-cmapi00069848/mcp",
      "headers": {
        "Authorization": "Bearer ${DASHSCOPE_API_KEY}"
      },
      "isActive": true
    },
    "context7": {
      "id": "context7",
      "source": "default",
      "name": "Context7 MCP",
      "description": "Upstash 上下文管理服务",
      "category": "knowledge",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "skillhub": {
      "id": "skillhub",
      "source": "default",
      "name": "SkillHub MCP",
      "description": "技能发现和管理服务",
      "category": "utilities",
      "command": "npx",
      "args": ["-y", "skillhub-mcp"]
    }
  }
}
